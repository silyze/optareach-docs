{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OptaReach Docs",
  "colors": {
    "primary": "#007BFF",
    "light": "#4EB5FF",
    "dark": "#0B3A75"
  },
  "favicon": "/favicon.ico",
  "openapi": "/api-reference/openapi.json",
  "api": {
    "baseUrl": "https://optareach.com",
    "playground": {
      "mode": "show"
    },
    "maintainOrder": true
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Workspace basics",
            "pages": [
              "workspace/accounts",
              "workspace/leads-and-campaigns"
            ]
          },
          {
            "group": "Platform playbooks",
            "pages": [
              "platforms/linkedin",
              "platforms/x",
              "platforms/reddit",
              "platforms/github",
              "platforms/hacker-news",
              "platforms/stackoverflow",
              "platforms/email"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "/api-reference/openapi.json"
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "OptaReach",
          "href": "https://optareach.com",
          "icon": "house"
        },
        {
          "anchor": "Support",
          "href": "mailto:support@optareach.com",
          "icon": "envelope"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Product",
        "href": "https://optareach.com"
      },
      {
        "label": "Pricing",
        "href": "https://optareach.com/pricing"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Start free trial",
      "href": "https://optareach.com/register"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://optareach.com",
      "linkedin": "https://optareach.com/contact"
    }
  }
}
